# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Template for environment configuration.
# Copy this file to .env and fill in your actual values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get from: https://t.me/BotFather  →  /newbot
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# ── Google Gemini (AI Studio) ─────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── ClickUp ───────────────────────────────────────────────────────────────────
# Get API Token from: ClickUp → Settings → Apps → API Token
CLICKUP_API_TOKEN=YOUR_CLICKUP_API_TOKEN_HERE

# Get List ID from the URL when viewing a List:
#   https://app.clickup.com/{workspace}/v/l/6-{LIST_ID}-1
CLICKUP_LIST_ID=YOUR_CLICKUP_LIST_ID_HERE

# ── Optional overrides ────────────────────────────────────────────────────────
# Gemini model name (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO)
# LOG_LEVEL=INFO

# Log file path (default: logs/bot.log)
# LOG_FILE=logs/bot.log

# Temp directory for downloaded voice files (default: temp)
# TEMP_DIR=temp
